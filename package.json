{
  "name": "@openseadragon-imaging/openseadragon-viewerinputhook",
  "version": "3.0.0",
  "type": "module",
  "description": "OpenSeadragon plugin which provides hooks into the viewer input event pipeline.",
  "license": "MIT",
  "author": {
    "name": "Mark Salsbery",
    "email": "msalsbery@hotmail.com",
    "url": "https://github.com/msalsbery"
  },
  "contributors": [
    {
      "name": "Tammy DiPrima"
    },
    {
      "name": "Stefan Frühwirth"
    },
    {
      "name": "Ian Gilman"
    }
  ],
  "homepage": "https://github.com/openseadragon-imaging/openseadragon-viewerinputhook#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/openseadragon-imaging/openseadragon-viewerinputhook.git"
  },
  "bugs": "https://github.com/openseadragon-imaging/openseadragon-viewerinputhook/issues",
  "keywords": [
    "openseadragon",
    "openseadragonimaging",
    "deep",
    "zoom",
    "dzi",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/openseadragon-viewerinputhook.d.ts",
  "module": "./dist/openseadragon-viewerinputhook.js",
  "browser": "./dist/openseadragon-viewerinputhook.umd.js",
  "exports": {
    ".": {
      "types": "./dist/openseadragon-viewerinputhook.d.ts",
      "import": "./dist/openseadragon-viewerinputhook.js",
      "require": "./dist/openseadragon-viewerinputhook.umd.js",
      "default": "./dist/openseadragon-viewerinputhook.js"
    }
  },
  "engines": {
    "node": ">= 22.0.0",
    "npm": ">= 6.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "doc": "npm run dev && jsdoc -c doc-conf.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix **/*",
    "prettier": "prettier --check \"**/*\"",
    "prettier:fix": "prettier --write \"**/*\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdoc": "^4.0.5",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1"
  },
  "peerDependencies": {
    "openseadragon": ">=3.0.0"
  }
}
